# Entrada única por HTTP (pruebas). Con el dominio real (*.infosmart.pe) se pone
# HTTPS con certificado comodín delante de este bloque (ver README, fase 4).
{
	auto_https off
}

:80 {
	encode gzip

	# La API interna solo se usa dentro de Docker (ventas → panel). Va en un handle:
	# Caddy evalúa los handle antes que un respond suelto.
	handle /api/interno/* {
		respond 404
	}

	# Panel Infosmart: admin.<dominio>, o la IP sola (http://190.119.59.24:8092)
	@panel host admin.{$DOMINIO_BASE} {$IP_PANEL} localhost
	handle @panel {
		handle /api/* {
			reverse_proxy panel-api:3100
		}
		handle {
			root * /srv/panel
			try_files {path} /index.html
			file_server
		}
	}

	# Cualquier otro subdominio es una empresa: sistema de ventas
	handle {
		reverse_proxy ventas:3000
	}
}
