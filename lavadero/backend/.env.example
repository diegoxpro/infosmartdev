# Copia este archivo como .env y cambia todos los valores. Nunca lo subas a un repositorio.
DB_CLAVE=cambia-esta-clave
# Mínimo 32 caracteres aleatorios
JWT_SECRETO=cambia-este-secreto-de-al-menos-32-caracteres
# Cifra el token, la clave SOL y el certificado guardados. Si se pierde, habrá que cargarlos de nuevo.
CLAVE_CIFRADO=cambia-esta-clave-de-cifrado-larga
ADMIN_USUARIO=admin
ADMIN_CLAVE=cambia-esta-clave-de-administrador
IP_PUBLICA=190.119.59.24
PUERTO=8443

# beta = pruebas sin valor tributario | produccion = comprobantes reales
SUNAT_ENTORNO=beta
SUNAT_RUC=20000000001
# En producción: usuario secundario SOL con perfil de emisión
SUNAT_USUARIO=MODDATOS
SUNAT_CLAVE=moddatos

# Contraseña del archivo backend/secretos/certificado.pfx (tu CDT)
CERT_CLAVE=
